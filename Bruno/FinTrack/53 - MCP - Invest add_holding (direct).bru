      "name": "Reliance Industries",
      "asset_type": "stock",
      "quantity": 10,
      "avg_buy_price": 2900
    }
  }
}

docs {
  Direct MCP call to invest-server. Expect: success true, action created/updated,
  holding with total_invested.
}
