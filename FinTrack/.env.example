# PostgreSQL
POSTGRES_DB=fintrack
POSTGRES_USER=fintrack_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://fintrack_user:change_me@postgres:5432/fintrack

# Redis
REDIS_URL=redis://redis:6379

# App
SECRET_KEY=replace_with_a_long_random_string
ENVIRONMENT=development

# ── AI Provider ───────────────────────────────────────────────────────────────
# Switch providers by changing these three lines. No code changes needed.
#
# Option 1: Groq (recommended — free tier, no credit card, fast)
#   Sign up at https://console.groq.com → API Keys → Create key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_groq_key_here
# NOTE: Groq moved the Llama chat models (llama-3.3-70b-versatile,
# llama-3.1-8b-instant) to Enterprise-only — free/developer keys get a 404
# model_not_found. Use an openai/gpt-oss-* model, which supports tool calling.
AI_MODEL=openai/gpt-oss-20b

# Option 2: Ollama (local, fully offline, zero cost)
#   Install: https://ollama.com → run: ollama pull llama3.2
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2

# Option 3: Gemini (via OpenAI-compatible endpoint)
#   Get key at https://aistudio.google.com/apikey
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=AIza_your_gemini_key_here
# AI_MODEL=gemini-2.0-flash
